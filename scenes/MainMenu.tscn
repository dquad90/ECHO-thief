[node name="Subtitle" type="Label" parent="HowToPlayView/Panel/Margin/VBox"]
layout_mode = 2
text = "Essential tactical guidelines for acoustic infiltration"
label_settings = SubResource("LabelSettings_PanelSub")
horizontal_alignment = 1

[node name="Sep" type="HSeparator" parent="HowToPlayView/Panel/Margin/VBox"]
layout_mode = 2

[node name="RulesList" type="VBoxContainer" parent="HowToPlayView/Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10
alignment = 1

[node name="Rule1" type="Label" parent="HowToPlayView/Panel/Margin/VBox/RulesList"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.92, 1, 0.9)
theme_override_font_sizes/font_size = 14
text = "🔊 SIGHT BY SOUND: Every step emits sound ripples that illuminate walls and guards in pitch-black darkness."
autowrap_mode = 2

[node name="Rule2" type="Label" parent="HowToPlayView/Panel/Margin/VBox/RulesList"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.92, 1, 0.9)
theme_override_font_sizes/font_size = 14
text = "👟 SILENT SNEAK: Press Shift / C or tap mobile SNEAK to creep silently and muffle your footsteps."
autowrap_mode = 2

[node name="Rule3" type="Label" parent="HowToPlayView/Panel/Margin/VBox/RulesList"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.92, 1, 0.9)
theme_override_font_sizes/font_size = 14
text = "🗺 SURFACES: Carpets absorb noise. Glass shatters and sends loud alarms across the wing!"
autowrap_mode = 2

[node name="Rule4" type="Label" parent="HowToPlayView/Panel/Margin/VBox/RulesList"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.92, 1, 0.9)
theme_override_font_sizes/font_size = 14
text = "🚪 WARDROBE HIDING: Duck into mahogany wardrobes (F, Space, or HIDE button) to disappear from guard sight."
autowrap_mode = 2

[node name="Rule5" type="Label" parent="HowToPlayView/Panel/Margin/VBox/RulesList"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.92, 1, 0.9)
theme_override_font_sizes/font_size = 14
text = "🎯 DISTRACTIONS: Tap screen or click to throw pebbles and lure guards away from vault gates."
autowrap_mode = 2

[node name="Rule6" type="Label" parent="HowToPlayView/Panel/Margin/VBox/RulesList"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.92, 1, 0.9)
theme_override_font_sizes/font_size = 14
text = "📹 SECURITY CAMERAS: Sweeping CCTV cones build up alert if you linger in sight. Hit with a pebble to short-circuit offline!"
autowrap_mode = 2

[node name="Rule7" type="Label" parent="HowToPlayView/Panel/Margin/VBox/RulesList"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.92, 1, 0.9)
theme_override_font_sizes/font_size = 14
text = "⚡ LASER TRIPWIRES: Pulsing security beams cycle on a timer. Dash when inactive, or toss a pebble to disable!"
autowrap_mode = 2

